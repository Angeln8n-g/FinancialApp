# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Instalar librerías de OpenSSL requeridas por Prisma en Alpine Linux
RUN apk add --no-cache openssl libc6-compat ca-certificates

# Copiar configuraciones y archivos del monorepo
COPY package*.json ./
COPY . .

# Instalar dependencias completas
RUN npm install --legacy-peer-deps

# Generar cliente de Prisma
RUN npx prisma generate --schema=packages/database/schema.prisma || true

ARG NEXT_PUBLIC_API_URL=https://api-hogariq.kasino21.com
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build --workspace=apps/web

# Stage 2: Production Runner
FROM node:20-alpine AS runner

WORKDIR /app

# Instalar librerías de OpenSSL en el contenedor de ejecución
RUN apk add --no-cache openssl libc6-compat ca-certificates

ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/web ./apps/web

EXPOSE 3000

CMD ["npm", "run", "start", "--workspace=apps/web"]
